# Crumbs — Environment Variables
# Copy this file to .env.local and fill in your values

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI Vision Provider (gemini | anthropic) ──────────────────────────────────
AI_PROVIDER=gemini

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# ── Anthropic Claude AI (Optional Alternative) ────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Extension CORS Allowlist ──────────────────────────────────────────────────
# Comma-separated list of allowed chrome extension origins (e.g. chrome-extension://<id>)
EXTENSION_ALLOWED_ORIGINS=chrome-extension://*
